# Copy to .env and replace values before starting Docker Compose.
BLACKBOX_PUBLIC_HOST=blackbox.example.com
# Start safely as read-only until you configure private hosting.
BLACKBOX_DEPLOY_MODE=public-demo
# Private mode only: long unique credentials (16+ character password).
BLACKBOX_BASIC_USER=
BLACKBOX_BASIC_PASSWORD=
# Private mode only: never put a cloud API key on a public demonstration.
BLACKBOX_CLOUD_PROVIDER=
BLACKBOX_CLOUD_API_KEY=
BLACKBOX_CLOUD_MODEL=
BLACKBOX_MAX_UPLOAD_MB=20
BLACKBOX_MAX_FRAMES=100000

# For separate accounts use BLACKBOX_DEPLOY_MODE=multi-user
# Create each account from inside the running container using create_account.py.

# Additional hosted security limits
BLACKBOX_MAX_CASES_PER_USER=12
BLACKBOX_MAX_CAPTURES_PER_CASE=20
BLACKBOX_MAX_USER_DISK_MB=500
BLACKBOX_MAX_TOTAL_DISK_MB=2048
BLACKBOX_WORKER_TIMEOUT_SECONDS=120
BLACKBOX_WORKER_MEMORY_MB=768
BLACKBOX_WORKER_CPU_SECONDS=90
